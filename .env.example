# Keplix backend origin. Required — the app throws at startup without it rather
# than silently falling back to production.
# Local backend: http://localhost:8000
# Production: https://keplix-backend-529844482719.asia-south1.run.app
#
# NEXT_PUBLIC_* values are inlined into the JS bundle at build time, not read at
# runtime: changing this requires a rebuild/redeploy, and setting it only in the
# hosting environment after the build has no effect. Trailing slashes are
# stripped in lib/apiConfig.js, so either form is safe.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth *web* client ID for sign-in.
# This same ID must also be listed in the backend's GOOGLE_ALLOWED_AUDIENCES
# (set on the --set-env-vars line in keplix-backend/.github/workflows/deploy.yml)
# or the backend rejects every token this client produces.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# No maps key is needed: the address step uses Leaflet with OpenStreetMap
# tiles and Nominatim geocoding, matching the mobile app's own map.
